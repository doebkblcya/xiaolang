{
  "name": "xiaolang",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.json && node scripts/build-plugins.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/main.js"
  },
  "dependencies": {
    "@cordisjs/plugin-loader": "1.0.0-rc.7",
    "@huggingface/tokenizers": "0.2.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@tencent-connect/qqbot-nodejs": "1.0.5",
    "ajv": "8.20.0",
    "cordis": "4.0.0-rc.10",
    "sqlite-vec": "0.1.9",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
